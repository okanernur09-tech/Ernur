<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<title>Luxury Gold Restaurant</title>

<style>
body {
    margin: 0;
    font-family: Arial;
    background: #000;
    color: gold;
}

header {
    text-align: center;
    padding: 25px;
    font-size: 32px;
    border-bottom: 2px solid gold;
}

.menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px;
}

.item {
    border: 1px solid gold;
    margin: 15px;
    padding: 15px;
    width: 220px;
    text-align: center;
    border-radius: 15px;
    background: #111;
}

.item img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 10px;
}

button {
    background: gold;
    color: black;
    border: none;
    padding: 10px;
    cursor: pointer;
    margin-top: 10px;
    font-weight: bold;
    border-radius: 5px;
}

.cart {
    position: fixed;
    right: 0;
    top: 0;
    background: black;
    border-left: 2px solid gold;
    width: 260px;
    height: 100%;
    padding: 15px;
    overflow-y: auto;
}

</style>
</head>

<body>

<header>💎 GOLD RESTAURANT 💎</header>

<div class="menu" id="menu"></div>

<div class="cart">
    <h2>🛒 Себет</h2>
    <ul id="cartList"></ul>
</div>

<script>

const foods = [
{ name:"Wagyu Steak", price:50000, img:"https://images.unsplash.com/photo-1551183053-bf91a1d81141" },
{ name:"Black Caviar", price:70000, img:"https://images.unsplash.com/photo-1604908176997-125f25cc6f3d" },
{ name:"Lobster", price:60000, img:"https://images.unsplash.com/photo-1544025162-d76694265947" },
{ name:"Gold Burger", price:45000, img:"https://images.unsplash.com/photo-1568901346375-23c9450c58cd" },
{ name:"Truffle Pasta", price:40000, img:"https://images.unsplash.com/photo-1525755662778-989d0524087e" },
{ name:"Sushi VIP", price:55000, img:"https://images.unsplash.com/photo-1553621042-f6e147245754" },
{ name:"Salmon", price:38000, img:"https://images.unsplash.com/photo-1467003909585-2f8a72700288" },
{ name:"Tomahawk Steak", price:65000, img:"https://images.unsplash.com/photo-1600891964599-f61ba0e24092" },
{ name:"Foie Gras", price:72000, img:"https://images.unsplash.com/photo-1606756790138-261d2b21cd0c" },
{ name:"Seafood", price:58000, img:"https://images.unsplash.com/photo-1565299624946-b28f40a0ae38" }
];

const menu = document.getElementById("menu");
const cartList = document.getElementById("cartList");

foods.forEach(food => {
    const div = document.createElement("div");
    div.className = "item";

    div.innerHTML = `
        <img src="${food.img}">
        <h3>${food.name}</h3>
        <p>${food.price} ₸</p>
        <button onclick="addToCart('${food.name}')">Қосу</button>
    `;

    menu.appendChild(div);
});

function addToCart(name){
    const li = document.createElement("li");
    li.textContent = name;
    cartList.appendChild(li);
}

</script>

</body>
</html>
